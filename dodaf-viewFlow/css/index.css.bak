@import "imgSize.css";
@import "iconStyle.css";

body{
    font-size: 12px;
    color: #000;
    line-height: 1;
}

.wrapper {
    width: 934px;
    height: 785px;
    border-radius: 16px;
    border: 2px solid #333;
    position: relative;
    background-image: linear-gradient(135deg, #ffffcd, #fff);
    margin: 30px auto;
    box-shadow: 3px 3px 3px 1px #999;
    padding: 0 12px;
    box-sizing: border-box;
}
.bg_title{
    position: absolute;
    top: 2px;
    left: 4px;
}

/* 分区通用样式 */
.zone {
    border: 1px solid #666;
    padding: 6px;
    position: absolute;
    box-shadow: 2px 2px 3px 1px #999;
    border-radius: 16px;
    box-sizing: border-box;
}

.zone-title {
    position: absolute;
    top: 2px;
    left: 6px;
}
.zone-1{
    width: 160px;
    height: 280px;
    top: 90px;
    left: 12px;
    background-image: linear-gradient(135deg, #e8fce3, #fff);
}
.zone-2{
    width: 430px;
    height: 315px;
    top: 90px;
    left: 180px;
    background-image: linear-gradient(135deg, #E8DEF7, #fff);
}
